#!/bin/bash
# hook: KWin 特效 (毛玻璃 blur / 圆角 / Overview) + Kvantum 主题
# 写入 /etc/skel 使新建用户 (live 用户 aura) 默认继承。
set -e
CFG=/etc/skel/.config
mkdir -p "$CFG"

# --- kwinrc: 启用 blur / fade / overview, 关闭桌面切换动画降低延迟 ---
cat > "$CFG/kwinrc" <<'EOF'
[Compositing]
Enabled=true
OpenGLIsUnsafe=false

[Effect-Blur]
BlurEnabled=true

[Effect-Fade]
enabled=true

[Plugins]
blurEnabled=true
kwin4_effect_fadeEnabled=true
overviewEnabled=true
highlightwindowEnabled=true

[org.kde.kdecoration2]
library=org.kde.breeze
BorderSize=Medium
ButtonsOnLeft=
ButtonsOnRight=H,M,X
EOF

# --- kdeglobals: 全局观感 (半透明/动画时长) ---
cat > "$CFG/kdeglobals" <<'EOF'
[General]
ColorScheme=Breeze
Fixed=Monospace,11
Font=Sans Serif,10,-1,5,50,0,0,0,0,0

[KDE]
AnimationDuration=120
SingleClick=false

[WM]
useCompositing=true
EOF

# --- kvantum: 用 WhiteSur-ish 半透明风格 (若主题缺失则默认) ---
KVA=/etc/skel/.config/Kvantum
mkdir -p "$KVA"
cat > "$KVA/kvantumrc" <<'EOF'
[General]
CurrentTheme=WhiteSur-dark
EOF

# --- kcmfonts: 关闭字体 DPI 自动缩放 (QEMU 下更稳) ---
cat > "$CFG/kcmfonts" <<'EOF'
[General]
forceFontDPI=0
EOF
