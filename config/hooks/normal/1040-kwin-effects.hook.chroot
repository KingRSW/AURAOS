#!/bin/bash
# hook: KWin 特效 (毛玻璃 blur / 圆角 / Overview) + Kvantum 主题
# 写入 /etc/skel 使新建用户 (live 用户 aura) 默认继承。
set -e
CFG=/etc/skel/.config
mkdir -p "$CFG"

# --- kwinrc: 启用 blur / fade / overview, 关闭桌面切换动画降低延迟 ---
cat > "$CFG/kwinrc" <<'EOF'
[Compositing]
Enabled=true
OpenGLIsUnsafe=false
LatencyPolicy=LatencyLow

[Effect-Blur]
BlurEnabled=true

[Effect-Fade]
enabled=true

[Plugins]
blurEnabled=true
kwin4_effect_fadeEnabled=true
overviewEnabled=true
highlightwindowEnabled=true

[org.kde.kdecoration2]
library=org.kde.aurorae
theme=WhiteSur-dark
BorderSize=Medium
ButtonsOnLeft=X,M,H
ButtonsOnRight=
EOF

# --- kdeglobals: 全局观感 (WhiteSurDark 配色 / Kvantum / Noto Sans CJK 字体) ---
cat > "$CFG/kdeglobals" <<'EOF'
[General]
ColorScheme=WhiteSurDark
Fixed=Noto Sans Mono CJK SC,10,-1,5,50,0,0,0,0,0
Font=Noto Sans CJK SC,10,-1,5,50,0,0,0,0,0
menuFont=Noto Sans CJK SC,10,-1,5,50,0,0,0,0,0
toolBarFont=Noto Sans CJK SC,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Noto Sans CJK SC,8,-1,5,50,0,0,0,0,0

[KDE]
AnimationDurationFactor=0.5
SingleClick=false
widgetStyle=kvantum

[WM]
useCompositing=true
EOF

# --- kvantum: WhiteSurDark (系统级 /usr/share/Kvantum, 1050 hook 安装) ---
KVA=/etc/skel/.config/Kvantum
mkdir -p "$KVA"
cat > "$KVA/kvantumrc" <<'EOF'
[General]
CurrentTheme=WhiteSurDark
EOF

# --- kcmfonts: 关闭字体 DPI 自动缩放 (QEMU 下更稳) ---
cat > "$CFG/kcmfonts" <<'EOF'
[General]
forceFontDPI=0
EOF
