#!/bin/bash
# hook: 打包前修剪 chroot — 降低 squashfs/ISO 体积与构建磁盘峰值。
# hooks 在 package-lists 安装之后执行 (编号 9000 保证最后跑)。
# 保留 /usr/share/doc (各包 copyright, 许可合规)。
set -e
apt-get clean || true
rm -rf /var/lib/apt/lists/* || true
rm -rf /usr/share/man /usr/share/info /usr/share/gnome/help || true
find /usr/share/locale -mindepth 1 -maxdepth 1 \
     ! -name zh_CN ! -name en ! -name en_US ! -name posix \
     -exec rm -rf {} + || true
du -sh / 2>/dev/null | tail -1 || true
