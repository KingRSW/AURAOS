#!/bin/bash
# hook: SDDM 自动登录 live 用户 aura 进入 Plasma 会话
# live-config 在启动时按 bootappend username=aura 创建用户, 此处只写配置。
# 会话名动态检测: Wayland 优先 (plasma 6 桌面在 wayland-sessions), 退回 X11。
set -e
mkdir -p /etc/sddm.conf.d

SESSION=""
for f in /usr/share/wayland-sessions/plasma*.desktop /usr/share/xsessions/plasma*.desktop; do
    [ -f "$f" ] && SESSION="$(basename "$f" .desktop)" && break
done
[ -n "$SESSION" ] || SESSION="plasma"
echo "autologin session: $SESSION"

cat > /etc/sddm.conf.d/aura-autologin.conf <<EOF
[Autologin]
User=aura
Session=$SESSION.desktop
Relogin=false
EOF

systemctl enable sddm 2>/dev/null || true
